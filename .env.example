# Existing credentials (keep real values in the ignored .env file)
GEMINI_API_KEY=
WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=

# Google Sheets service account; optional explicit ID overrides sheet name
GOOGLE_APPLICATION_CREDENTIALS=fabricbot.json
GOOGLE_SHEET_NAME=Curtains Q2 and July 2025
GOOGLE_SHEET_TAB=data
# GOOGLE_SHEET_ID=
SHEET_CACHE_TTL_SECONDS=300

# Search: return this many nearest available photos, maximum 10
FABRIC_SEARCH_RESULT_COUNT=5
# FABRIC_INDEX_PATH=/absolute/path/to/data/fabrics.sqlite3
GEMINI_MODEL=gemini-2.5-flash
WHATSAPP_API_VERSION=v23.0
